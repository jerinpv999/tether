{
  "name": "flowforge",
  "version": "2.0.0",
  "description": "Workflow orchestrator: HA master cluster (etcd/Mongo leader election) + scalable worker apps that host one process per workflow; gRPC with Basic auth; YAML config; Fabric.js designer",
  "main": "src/master/index.js",
  "scripts": {
    "start": "node bin/master.js --config config/single-node.yaml",
    "master": "node bin/master.js --config",
    "worker": "node bin/worker.js --config",
    "test": "node test/e2e.js",
    "test:cluster": "node test/cluster.js"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "@grpc/grpc-js": "^1.10.0",
    "@grpc/proto-loader": "^0.7.10",
    "express": "^4.19.2",
    "fabric": "5.3.0",
    "yaml": "^2.9.1"
  },
  "optionalDependencies": {
    "amqplib": "^0.10.9",
    "etcd3": "^1.1.2",
    "mongodb": "^6.21.0",
    "mqtt": "^5.16.1"
  },
  "license": "MIT",
  "bin": {
    "flowforge-master": "bin/master.js",
    "flowforge-worker": "bin/worker.js"
  }
}